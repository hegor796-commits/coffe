{
  "name": "nutri-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Нутри — каркас Telegram Mini App для предзаказа с ролями клиент/сотрудник/админ (на базе платформы предзаказа)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @coffee/api prisma migrate dev",
    "db:seed": "pnpm --filter @coffee/api db:seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
