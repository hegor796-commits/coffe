# --- Backend (apps/api) ---
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=https://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://coffee:coffee@localhost:5432/coffee?schema=public

# Redis (кеш, pub/sub, BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-prod-please-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Telegram (общий бот платформы на MVP)
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_REAL_BOT_TOKEN
# Внешний URL для webhook бота (в dev — cloudflared туннель)
TELEGRAM_WEBHOOK_URL=
# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret

# Шифрование секретов эквайринга (AES-256-GCM, 32 байта в hex/base64)
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# S3 / MinIO (фото меню)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=coffee-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/coffee-media

# --- Frontend (apps/tma) ---
VITE_API_URL=http://localhost:3000
