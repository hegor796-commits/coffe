# --- Обязательные ---
PORT=3000
# Внешний HTTPS-адрес самого бэкенда (домен Railway). Нужен для вебхуков ботов.
PUBLIC_URL=https://your-service.up.railway.app
# Где лежит мини-апп (UI). Сейчас — на GitHub Pages. На него ведут кнопки ботов.
WEB_APP_BASE=https://hegor796-commits.github.io/coffe

# Telegram id владельцев платформы (ты) — через запятую. Только они дергают админ-API.
SUPERADMIN_TG_IDS=123456789
# Секрет для админ-API (заголовок X-Admin-Secret). Придумайте длинную строку.
ADMIN_SECRET=change-me-long-random-string

# Каталог данных (SQLite). На Railway = точка монтирования Volume.
DATA_DIR=/data

# --- Демо-кофейня «Любовь-Марковь» (создаётся при первом старте) ---
# Токен её бота от @BotFather. Без него демо-тенант создастся без бота.
DEMO_BOT_TOKEN=
# Telegram id владельца/бариста демо-кофейни (чтобы зайти под этими ролями).
# Можно перечислить несколько через запятую: SEED_OWNER_TG_ID=111,222
SEED_OWNER_TG_ID=
SEED_BARISTA_TG_ID=

# --- Оплата ---
# Касса ЮKassa напрямую (личный кабинет → Интеграция → Ключи API).
# Если заданы обе переменные — оплата идёт по ссылке во внешнем браузере:
# клиент выбирает карту или СБП (свой банк) и подтверждает в приложении банка.
# Это заменяет платёжную шторку Telegram, которая умеет только карту.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Адрес для уведомлений об оплате печатается в логах при старте — его нужно
# вставить в ЮKassa: Интеграция → HTTP-уведомления (события payment.succeeded
# и payment.canceled). Без него оплата тоже дойдёт (приложение опрашивает
# статус само), но уведомление доставляет её быстрее и надёжнее.

# Имя бота без @ — кнопка «Вернуться в Telegram» на странице после оплаты.
TELEGRAM_BOT_USERNAME=

# Слать ли чек 54-ФЗ вместе с платежом. Требует подключённой облачной кассы:
# без неё ЮKassa вернёт ошибку, тогда ставьте false (e-mail тоже спрашивать
# перестанем).
YOOKASSA_RECEIPT_ENABLED=true
# Ставка НДС в чеке: 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20%, 5 — 10/110, 6 — 20/120.
YOOKASSA_VAT_CODE=1

# Токен провайдера из BotFather — запасной путь (шторка Telegram).
# Используется, только если ключи ЮKassa выше не заданы.
DEMO_PROVIDER_TOKEN=
# Наценка за упаковку, ₽ (0 — не показывать строку в корзине).
SEED_PACKAGING_FEE=0

# --- Необязательные ---
# Свежесть initData, сек (по умолчанию 86400 = 24 ч).
INITDATA_MAX_AGE_SEC=86400
# Ставить вебхуки ботам автоматически при старте (нужен PUBLIC_URL).
AUTO_SET_WEBHOOKS=true
# Сколько живёт неоплаченный счёт, мин (по умолчанию 20). Клиент открыл окно
# оплаты и ушёл — через это время заказ гасится и не мешает заказать заново.
PENDING_ORDER_TTL_MIN=20

# --- Режим работы ---
# Окно работы одной строкой. Выходной день — «-» или пусто.
SEED_HOURS_WEEKDAY=08:00-21:00
SEED_HOURS_WEEKEND=10:00-20:00
# Часовой пояс кофейни (в нём считаются часы работы).
SEED_TIMEZONE=Europe/Moscow
# За сколько минут до закрытия перестаём принимать заказы.
SEED_LAST_ORDER_DELIVERY_MIN=60
SEED_LAST_ORDER_PICKUP_MIN=30
